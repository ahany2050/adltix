{
  "name": "adltix",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:merchant": "turbo run dev --filter=merchant-portal",
    "dev:influencer": "turbo run dev --filter=influencer-portal",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:migrate": "supabase db push",
    "db:generate-types": "supabase gen types typescript --local > packages/database/src/types.ts",
    "db:reset": "supabase db reset"
  },
  "devDependencies": {
    "turbo": "^2.4.0",
    "typescript": "^5.7.0"
  },
  "packageManager": "pnpm@10.33.0"
}
