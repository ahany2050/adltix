# ===========================================
# Supabase
# ===========================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Public keys for influencer portal (Next.js)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ===========================================
# Shopify (Merchant Portal)
# ===========================================
SHOPIFY_API_KEY=your-shopify-api-key
SHOPIFY_API_SECRET=your-shopify-api-secret
SCOPES=read_orders,read_fulfillments,read_products,read_customers,write_discounts
SHOPIFY_APP_URL=https://adltix-merchant.vercel.app

# ===========================================
# Stripe
# ===========================================
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ===========================================
# App URLs
# ===========================================
NEXT_PUBLIC_APP_URL=https://app.adltix.com
MERCHANT_APP_URL=https://adltix-merchant.vercel.app
